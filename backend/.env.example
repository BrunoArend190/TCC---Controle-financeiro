# Copie este arquivo para ".env" e ajuste os valores.

# Conexão com o PostgreSQL (usuário:senha@host:porta/banco)
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@localhost:5432/gestao_financeira

# Chave usada para assinar os tokens JWT (troque por um valor aleatório longo)
JWT_SECRET=troque-esta-chave
JWT_EXPIRA_MINUTOS=480

# Ollama / NuExtract3
OLLAMA_URL=http://localhost:11434
NUEXTRACT_MODELO=numind/nuextract3:Q4_K_M
NUEXTRACT_TIMEOUT_SEGUNDOS=180

# Uploads
PASTA_UPLOADS=uploads
TAMANHO_MAX_UPLOAD_MB=10

# Origens liberadas no CORS (frontend Vite)
CORS_ORIGINS=["http://localhost:5173"]
